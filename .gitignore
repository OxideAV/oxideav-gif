/target
# Anchor to the crate root so the library's lockfile stays untracked
# but `fuzz/Cargo.lock` (conventional for a cargo-fuzz crate, which is a
# separate non-published binary member) can be committed for reproducible
# fuzz builds.
/Cargo.lock
**/*.rs.bk
.DS_Store

# cargo-fuzz inputs/outputs — corpus is a flywheel built locally,
# crash artifacts are not pinned in the tree.
fuzz/corpus/
fuzz/artifacts/
